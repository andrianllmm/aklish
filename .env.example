# A long, random, secret string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Set to False in production.
DJANGO_DEBUG=True

# Comma-separated list of hostnames this site may be served from.
# e.g. DJANGO_ALLOWED_HOSTS=aklish.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of extra scheme+host origins allowed for CORS/CSRF
# (in addition to localhost, which is always allowed).
# e.g. DJANGO_TRUSTED_ORIGINS=https://aklish.onrender.com
DJANGO_TRUSTED_ORIGINS=

# Database URL.
# Falls back to sqlite3 locally when unset.
DATABASE_URL=

# Username and email of the superuser that dictionary examples loaded via
# `loaddictionary` are attributed to. Required for `loaddictionary` to run.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
